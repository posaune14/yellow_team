# Copy to server/.env for local development. In production (Render),
# set these in the dashboard's Environment settings.

# MongoDB connection string
URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority

# Secret used to sign JWTs - generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
